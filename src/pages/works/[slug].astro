---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Button from '../../components/Button.astro';
import Icon from '../../components/Icon.astro';
import CtaGlow from '../../components/CtaGlow.astro';
import { projects } from '../../data/projects.js';
import { site } from '../../data/site.js';
import { getProjectImages, galleryRows } from '../../lib/images.js';

export function getStaticPaths() {
  return projects.map((project, i) => ({
    params: { slug: project.slug },
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}

const { project, next } = Astro.props;
const [hero, ...gallery] = getProjectImages(project.slug);
const rows = galleryRows(gallery);
const nextCover = getProjectImages(next.slug)[0];
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const shareText = `${project.title} — ${site.name}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: project.title,
  description: project.intro,
  url: pageUrl,
  genre: project.category,
  creator: { '@type': 'Organization', name: site.name, url: site.url },
};
---

<Base title={project.title} description={project.intro} image={hero.src} jsonLd={jsonLd}>
  <section class="page-hero project-hero">
    <div class="wrap wrap--narrow">
      <p class="label" data-reveal>(Project) — {project.category}</p>
      <h1 class="display h1--xl project-hero__title" data-split>{project.title}</h1>
      <p class="project-hero__sub" data-split>{project.subtitle}</p>
      <p class="lead" data-reveal>{project.intro}</p>
    </div>
  </section>

  <div class="wrap">
    <div class="media media--img project-cover" data-media-reveal>
      <Image src={hero} alt={`${project.title} by TruQ Design Studio`} widths={[768, 1080, 1440, 1920, 2400]} sizes="(min-width: 1340px) 1240px, 100vw" loading="eager" priority />
      <div class="share" data-share data-share-url={pageUrl} data-share-text={shareText}>
        <button type="button" class="share__btn" aria-expanded="false" aria-haspopup="true" data-share-toggle>
          <Icon name="share" />
          <span>Share</span>
          <span class="share__chev"><Icon name="chevron" /></span>
        </button>
        <ul class="share__menu" hidden data-share-menu>
          <li><button type="button" data-share-copy><Icon name="link" />Copy link</button></li>
          <li><a href={`https://wa.me/?text=${encodeURIComponent(`${shareText} ${pageUrl}`)}`} target="_blank" rel="noopener">WhatsApp</a></li>
          <li><a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(pageUrl)}`} target="_blank" rel="noopener">LinkedIn</a></li>
          <li><a href={`mailto:?subject=${encodeURIComponent(shareText)}&body=${encodeURIComponent(pageUrl)}`}>Email</a></li>
        </ul>
      </div>
    </div>
  </div>

  <section class="section project-details">
    <div class="wrap wrap--narrow project-details__grid">
      <dl class="meta-list">
        {project.meta.map(([k, v]) => (
          <div class="meta-list__row" data-reveal>
            <dt class="label">{k}</dt>
            <dd>{v}</dd>
          </div>
        ))}
      </dl>
      <div class="project-details__body">
        {project.body.map(p => <p data-reveal>{p}</p>)}
        <div data-reveal>
          <Button enquiry service={project.tags.includes('interiors') ? 'Interiors' : project.tags.includes('hospitality') ? 'Hospitality' : 'Architecture'}>Enquire about a similar project</Button>
        </div>
      </div>
    </div>
  </section>

  {rows.length > 0 && (
    <section class="project-gallery" aria-label={`${project.title} gallery`}>
      <div class="wrap gallery">
        {rows.map(row => (
          <div class:list={['gallery__row', `gallery__row--${row.type}`, { 'is-portrait': row.portrait }]}>
            {row.items.map(img => (
              <div class="media gallery__item" data-media-reveal>
                <Image
                  src={img}
                  alt={`${project.title} — interior and architecture detail`}
                  widths={row.type === 'full' ? [768, 1080, 1440, 1920] : [480, 768, 1080]}
                  sizes={row.type === 'full' ? '(min-width: 1340px) 1240px, 100vw' : '(min-width: 760px) 50vw, 100vw'}
                />
              </div>
            ))}
          </div>
        ))}
      </div>
    </section>
  )}

  <section class="section next-project rule-top">
    <div class="wrap wrap--narrow next-project__grid">
      <div>
        <p class="label" data-reveal>(Next project)</p>
        <h2 class="h3 next-project__title" data-split>{next.title}</h2>
        <p class="label next-project__kind" data-reveal>{next.category} — {next.kind}</p>
        <div data-reveal>
          <Button href={`/works/${next.slug}/`} variant="dark">View project</Button>
        </div>
      </div>
      <a href={`/works/${next.slug}/`} class="media next-project__media" data-media-reveal data-cursor="Next" aria-label={`Next project: ${next.title}`}>
        <Image src={nextCover} alt="" widths={[480, 768, 1080]} sizes="(min-width: 1024px) 40vw, 100vw" />
      </a>
    </div>
  </section>

  <CtaGlow title="Curious about a project of your own?" />
</Base>
