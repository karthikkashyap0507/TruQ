---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import CtaGlow from '../../components/CtaGlow.astro';
import Icon from '../../components/Icon.astro';
import { articles, formatDate } from '../../data/articles.js';
import { site } from '../../data/site.js';

export function getStaticPaths() {
  return articles.map(article => ({ params: { slug: article.slug }, props: { article } }));
}

const { article } = Astro.props;
const more = articles.filter(a => a.slug !== article.slug).slice(0, 3);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: article.title,
  description: article.excerpt,
  datePublished: article.date,
  author: { '@type': 'Organization', name: site.name },
  publisher: { '@type': 'Organization', name: site.name, url: site.url },
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
};
---

<Base title={article.title} description={article.excerpt} image={article.image.src} type="article" jsonLd={jsonLd}>
  <article>
    <header class="page-hero article-hero">
      <div class="wrap wrap--narrow">
        <a href="/journal/" class="label article-hero__back link-line" data-reveal><Icon name="arrow-left" /> Journal</a>
        <p class="label" data-reveal>{article.category} · {formatDate(article.date)} — {article.readTime}</p>
        <h1 class="display h1 article-hero__title" data-split>{article.title}</h1>
        <p class="lead article-hero__lead" data-reveal>{article.excerpt}</p>
      </div>
    </header>

    <div class="wrap">
      <div class="media media--img article-cover" data-media-reveal>
        <Image src={article.image} alt={article.title} widths={[768, 1080, 1440, 1920]} sizes="(min-width: 1340px) 1240px, 100vw" loading="eager" priority />
      </div>
    </div>

    <div class="wrap wrap--narrow">
      <div class="prose">
        {article.body.map(block => {
          if (block.type === 'h') return <h2 data-reveal>{block.text}</h2>;
          if (block.type === 'quote') return <blockquote data-reveal><p>{block.text}</p></blockquote>;
          if (block.type === 'lines') return <p class="prose__lines" data-reveal>{block.items.map(line => <span>{line}</span>)}</p>;
          return <p data-reveal>{block.text}</p>;
        })}
        <p class="prose__sign label" data-reveal>— TruQ Design Studio</p>
      </div>
    </div>
  </article>

  <section class="section rule-top">
    <div class="wrap">
      <p class="label journal-all__label" data-reveal>(More from the journal)</p>
      <div class="card-grid">
        {more.map(a => <ArticleCard article={a} data-reveal />)}
      </div>
    </div>
  </section>

  <CtaGlow label="(Begin)" title="Ready when you are." button="Tell us about your project" />
</Base>
