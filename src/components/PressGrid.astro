---
import { Image } from 'astro:assets';
import { press } from '../data/press.js';
---

<div class="press-grid">
  {press.map((item, i) => (
    <figure class:list={['press-item', { 'press-item--wide': item.wide }]} data-reveal style={`--i:${i}`}>
      <div class="media press-item__media" data-media-reveal>
        <Image src={item.image} alt={item.alt} widths={item.wide ? [480, 768, 1080] : [320, 480, 640]} sizes={item.wide ? '(min-width: 1024px) 30vw, 100vw' : '(min-width: 1024px) 14vw, 50vw'} />
      </div>
      <figcaption class="label">{item.label}</figcaption>
    </figure>
  ))}
</div>
