---
const { name, class: className = '', ...rest } = Astro.props;

const paths = {
  arrow: '<path d="M2 8h12M9 3l5 5-5 5" />',
  'arrow-left': '<path d="M14 8H2M7 3 2 8l5 5" />',
  'arrow-up-right': '<path d="M4 12 12 4M5.5 4H12v6.5" />',
  chevron: '<path d="m4 6 4 4 4-4" />',
  share: '<path d="M8 10V2M5 5l3-3 3 3M3 9v4.5h10V9" />',
  close: '<path d="m3.5 3.5 9 9M12.5 3.5l-9 9" />',
  mail: '<rect x="1.75" y="3.25" width="12.5" height="9.5" rx="1.5" /><path d="m2.5 4.5 5.5 4 5.5-4" />',
  phone: '<path d="M3.2 1.8h2.4l1.1 3-1.5 1a8.3 8.3 0 0 0 5 5l1-1.5 3 1.1v2.4a1.4 1.4 0 0 1-1.5 1.4A12.6 12.6 0 0 1 1.8 3.3 1.4 1.4 0 0 1 3.2 1.8Z" />',
  pin: '<path d="M8 14.5s-4.75-4.3-4.75-8a4.75 4.75 0 0 1 9.5 0c0 3.7-4.75 8-4.75 8Z" /><circle cx="8" cy="6.4" r="1.6" />',
  link: '<path d="M6.5 9.5 9.5 6.5M7 4.5l1.3-1.3a2.8 2.8 0 0 1 4 4L11 8.5M9 11.5l-1.3 1.3a2.8 2.8 0 0 1-4-4L5 7.5" />',
  plus: '<path d="M8 3v10M3 8h10" />',
};
---

<svg
  class={`icon ${className}`}
  viewBox="0 0 16 16"
  fill="none"
  stroke="currentColor"
  stroke-width="1.4"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  {...rest}
  set:html={paths[name]}
/>
