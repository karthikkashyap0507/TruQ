---
import { Image } from 'astro:assets';
import { formatDate } from '../data/articles.js';

const { article, class: className = '', ...rest } = Astro.props;
---

<article class={`article-card ${className}`} {...rest}>
  <a href={`/journal/${article.slug}/`} class="article-card__link" data-cursor="Read">
    <div class="media ratio-4-3 article-card__media">
      <Image src={article.image} alt={article.title} widths={[480, 768, 1080]} sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw" />
    </div>
    <p class="label article-card__meta">{article.category} · {formatDate(article.date)}</p>
    <h3 class="h4 article-card__title">{article.title}</h3>
    <p class="body-sm">{article.excerpt}</p>
  </a>
</article>
