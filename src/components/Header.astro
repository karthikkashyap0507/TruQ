---
import Logo from './Logo.astro';
import Button from './Button.astro';
import { nav, site } from '../data/site.js';

// overlay: header sits transparent and light over a full-bleed hero until the page scrolls.
const { overlay = false } = Astro.props;
const path = Astro.url.pathname;
const isActive = href => path === href || (href !== '/' && path.startsWith(href));
---

<header class:list={['site-header', { 'site-header--overlay': overlay }]} data-header>
  <div class="site-header__inner">
    <Logo />
    <nav class="site-nav" aria-label="Primary">
      <ul>
        {nav.map(item => (
          <li>
            <a href={item.href} class:list={['site-nav__link', { 'is-active': isActive(item.href) }]} aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="site-header__cta">
      <Button enquiry variant="dark" dot class="site-header__btn">Begin a project</Button>
    </div>
    <button class="menu-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu" data-menu-open>
      <span></span><span></span>
    </button>
  </div>
</header>

<div class="mobile-menu dark" id="mobile-menu" role="dialog" aria-modal="true" aria-label="Menu" hidden data-menu data-lenis-prevent>
  <div class="mobile-menu__top">
    <Logo />
    <button class="icon-btn icon-btn--dark" type="button" aria-label="Close menu" data-menu-close>
      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true"><path d="m3.5 3.5 9 9M12.5 3.5l-9 9" /></svg>
    </button>
  </div>
  <nav class="mobile-menu__nav" aria-label="Mobile">
    <ol>
      {nav.map((item, i) => (
        <li data-menu-item>
          <a href={item.href} class:list={{ 'is-active': isActive(item.href) }} aria-current={isActive(item.href) ? 'page' : undefined}>
            <span class="label">({String(i + 1).padStart(2, '0')})</span>
            <span class="mobile-menu__link">{item.label}</span>
          </a>
        </li>
      ))}
    </ol>
  </nav>
  <div class="mobile-menu__foot" data-menu-item>
    <p class="label">{site.studios.join(' · ')}</p>
    <p class="mobile-menu__contact">
      <a href={`mailto:${site.email}`}>{site.email}</a>
      <a href={site.phoneHref}>{site.phone}</a>
    </p>
    <a class="label" href={site.instagramUrl} target="_blank" rel="noopener">Instagram — {site.instagram}</a>
    <Button enquiry variant="light" dot block>Begin a project</Button>
  </div>
</div>
